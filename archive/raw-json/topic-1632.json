um.availproject.org/igork/{size}/909_2.png","created_at":"2025-01-22T09:28:17.628Z","cooked":"\u003cp\u003eSounds like a solid move to raise the ideal_stake to 75%. It helps boost network security, keeps APY stable, and matches the ecosystem’s growth. The runtime upgrade approach also seems straightforward and safe.\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":8,"updated_at":"2025-01-22T09:28:17.628Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":16,"readers_count":15,"score":53.2,"yours":false,"topic_id":1632,"topic_slug":"aip-5-increase-ideal-staking-ratio-to-75","display_username":"Igor","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":1031,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/aip-5-increase-ideal-staking-ratio-to-75/1632/7","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":2777,"name":"Jackson Lewis","username":"SocialForging","avatar_template":"/user_avatar/forum.availproject.org/socialforging/{size}/849_2.png","created_at":"2025-01-22T11:19:14.543Z","cooked":"\u003cp\u003eThis change has been implemented\u003c/p\u003e\n\u003caside class=\"quote quote-modified\" data-post=\"1\" data-topic=\"1640\"\u003e\n  \u003cdiv class=\"title\"\u003e\n    \u003cdiv class=\"quote-controls\"\u003e\u003c/div\u003e\n    \u003cimg loading=\"lazy\" alt=\"\" wid